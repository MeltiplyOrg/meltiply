{
  "name": "meltiply",
  "image": "ghcr.io/tmih06/herdr-devcontainer-vibecode-essential:latest",
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "MELTIPLY_DEV_TUNNEL": "1",
    "BUN_INSTALL_CACHE_DIR": "/home/dev/.bun/install/cache",
    "MELTIPLY_DEVCONTAINER": "1",
    "COMPOSE_PROJECT_NAME": "meltiply-${devcontainerId}",
    "MELTIPLY_DEVCONTAINER_WORKSPACE": "${localWorkspaceFolder}",
    "MELTIPLY_DEVCONTAINER_CONFIG": "/opt/meltiply-devcontainer",
    "MELTIPLY_DEVCONTAINER_HOST_CONFIG": "${localWorkspaceFolder}/.devcontainer"
  },
  "runArgs": [
    "--network=bridge",
    "--label=meltiply.devcontainer.project=meltiply-${devcontainerId}"
  ],
  "postCreateCommand": "sudo mkdir -p /home/dev/.bun/install/cache && sudo chown -R dev:dev /home/dev/.bun",
  "mounts": [
    "source=meltiply-bun-cache,target=/home/dev/.bun/install/cache,type=volume",
    "source=${localWorkspaceFolder}/.devcontainer,target=/opt/meltiply-devcontainer,type=bind,readonly"
  ]
}
