# Meltiply local development environment.
# `make setup` creates the ignored root `.env` from this file.
# All boot, test, Worker, and frontend-app/public-site commands read this file.

# One canonical dashboard/API origin. Local launchers derive it from the selected
# frontend host/port; tunnels replace it automatically. For deployment set APP_URL.
# PUBLIC_SITE_URL is only for the separate landing/docs site; local defaults are automatic.
WRANGLER_DEV_PORT=8787
FRONTEND_DEV_PORT=3000
PUBLIC_SITE_DEV_PORT=4321
APP_URL=
PUBLIC_SITE_URL=
# Optional additional trusted browser origins; APP_URL is always included.
ALLOWED_ORIGINS=
ENVIRONMENT=local
VERSION=1.0.0-target.0
LOG_SAMPLE_RATE=1

# Development is loopback-only by default. Set MELTIPLY_DEV_TUNNEL=1 to publish
# the app and public site through Cloudflare Tunnel. The app Worker proxies
# /api/* to the API Worker, keeping sessions on one origin.
# MELTIPLY_DEV_HOST=workstation.example.test opts into a network hostname.
#
# A Cloudflare Quick Tunnel is used, and it is the only mode that needs no
# cleanup: Cloudflare deletes the tunnel and its DNS record about five minutes
# after the connector disconnects, so a container that is cut off leaves
# nothing behind. The hostname is random and changes every run.
#
# A NAMED tunnel on your own domain (MELTIPLY_DEV_TUNNEL_MODE=named) gives a
# stable hostname per branch, but it opts OUT of that automatic cleanup: it and
# its DNS records persist until deleted by hand, so it leaks one tunnel and two
# CNAMEs per branch. Only use it where a stable URL is required, such as an
# OAuth redirect URI, and delete it when you are done.
#
# Set MELTIPLY_DEV_TUNNEL=1 only when public OAuth/webhook callbacks are needed.
# MELTIPLY_CLOUDFLARED_BIN overrides the connector binary.
MELTIPLY_DEV_TUNNEL=0
# TUNNEL_TRANSPORT_PROTOCOL=auto   (auto, http2, or quic)
# MELTIPLY_DEV_TUNNEL_MODE=named   (opt in to a named tunnel; see the warning
#                                   printed by `make dev` before it provisions)
# MELTIPLY_TUNNEL_NAME_PREFIX=meltiply-dev   (named mode; tunnel <prefix>-<branch>)
# MELTIPLY_TUNNEL_DOMAIN=example.com         (required in named mode; a domain you own)
# MELTIPLY_TUNNEL_DEV_LABEL=  (blank: <branch>.example.com, one label deep for
#                            Cloudflare Universal SSL; an extra label needs a custom certificate)
# MELTIPLY_TUNNEL_SHARED=1                   (named mode; one tunnel + one wildcard
#                                             record for all branches)
# MELTIPLY_TUNNEL_NAME=meltiply-dev          (named mode, only with SHARED=1)
# MELTIPLY_TUNNEL_HOST_STYLE=wildcard        (named mode; <branch>.example.com)
# MELTIPLY_TUNNEL_HOST_STYLE=flat            (named mode; <branch>-dev.example.com)
# MELTIPLY_TUNNEL_BRANCH=                     (named mode; defaults to the branch)
# MELTIPLY_TUNNEL_CREDENTIALS_FILE=          (named mode; if not in ~/.cloudflared)

# Setup generates blank secrets once and keeps existing values unchanged.
# Better Auth sessions use APP_URL; there is no separate public auth URL.
# The secret stays server-only; the session reaches the browser exclusively
# through the HttpOnly same-origin cookie, so no public auth key exists.
BETTER_AUTH_SECRET=
# Bootstrap only: use the generated value from .env on the first-run setup page.
# Never expose it as a frontend build variable.
AUTH_SETUP_SECRET=
# Optional trusted internal signing-key endpoint; does not change issuer/audience.
# Local launchers default to the local API to avoid Cloudflare Access redirects.
BETTER_AUTH_JWKS_URL=

# Deployed Workers require verified email by default. Set false only when
# intentionally running without verification mail; local/test skip verification.
REQUIRE_EMAIL_VERIFICATION=true

# Transactional email delivery through the Cloudflare send_email binding for
# Better Auth verification/recovery and Workspace invitations. The API Worker
# sends through the native MAIL binding, so no API key exists to configure.
# `wrangler dev` simulates the binding locally: messages are captured in dev
# output and nothing is really sent, so `MAIL_FROM_ADDRESS` needs no real
# domain and `MAIL_FROM_NAME` stays optional. For an explicit real-delivery
# check, point `wrangler dev` at a disposable config that marks only the MAIL
# binding `remote: true` and pins `allowed_sender_addresses` and
# `allowed_destination_addresses` to your controlled addresses — never enable
# that in the checked-in configs.
# https://developers.cloudflare.com/email-service/local-development/sending/
MAIL_FROM_ADDRESS=no-reply@meltiply.local
# MAIL_FROM_NAME=Meltiply


# Local database and storage bindings.
MELTIPLY_DATABASE_TEST_URL=postgres://meltiply_rls:meltiply-authenticated-local@localhost:5433/meltiply?sslmode=disable
# Benchmark preparation is local-only; 1 explicitly allows destructive remote DB operations.
BENCHMARK_ALLOW_REMOTE_DATABASE=0
# Object storage provider: `r2` (default) or `s3`. Leave unset to keep using the
# ASSETS R2 binding below; set it to `s3` to read, write, and sign against any
# S3-compatible service instead. Every Worker resolves the provider from this one
# variable, so switching backends is a configuration change, not a code change.
OBJECT_STORAGE_PROVIDER=r2
# Cloudflare R2 settings; used only when OBJECT_STORAGE_PROVIDER is `r2`.
R2_ACCESS_KEY_ID=local-r2-access-key
R2_ACCOUNT_ID=local-r2-account-id
R2_BUCKET_NAME=meltiply-assets-local
R2_SECRET_ACCESS_KEY=local-r2-secret-key
# S3-compatible settings; used only when OBJECT_STORAGE_PROVIDER is `s3`.
# S3_ENDPOINT must be an origin with no path, and HTTPS outside local or test
# environments. S3_FORCE_PATH_STYLE defaults to true
# (MinIO, Ceph, and most self-hosted services); set it to false for AWS-style
# virtual-hosted addressing. S3_REGION defaults to us-east-1.
S3_ACCESS_KEY_ID=
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
S3_REGION=
S3_SECRET_ACCESS_KEY=
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEYRING=

# Local Cloudflare Container runtime for the native media processor.
#
# `wrangler dev` builds and starts the Automation Worker's media processor
# container (linux/amd64) through the local Docker daemon. Leave this true to
# process media locally; set it to false to boot the rest of the stack without
# the engine, in which case asset processing fails with a real error instead of
# silently skipping optimization.
WRANGLER_DEV_ENABLE_CONTAINERS=true

# Non-secret job authentication for the processor engine, used only by the local
# engine smoke harness. The Automation Worker's MediaProcessorContainer Durable
# Object mints a random PROCESSOR_JOB_TOKEN per instance and passes it to the
# container at start, so no deployed Worker or Container ever reads this value.
# It authorizes exactly one job endpoint and grants no R2 access: jobs receive
# short-lived, object-scoped signed URLs instead of bucket credentials.
PROCESSOR_JOB_TOKEN=local-processor-job-token

# Engine smoke harness overrides. Leave the host blank to use the container's
# published port directly, and the port blank to let the harness choose a free
# one; the harness generates a job token when PROCESSOR_JOB_TOKEN is unset.
PROCESSOR_SMOKE_HOST=
PROCESSOR_SMOKE_PORT=

# Operator and provider credentials. Keep empty until real credentials exist;
# provider capabilities remain fail-closed when acceptance is false.
ACCESS_POLICY_AUD=local-operator-audience
ACCESS_TEAM_DOMAIN=https://example.cloudflareaccess.com
OPERATOR_HOSTNAME=ops.localhost
# Facebook Page Reels require pages_show_list, pages_read_engagement, and
# pages_manage_posts; business_management discovers business-assigned Pages.
# Enable these permissions in the Meta app; do not add publish_video.
# Existing Facebook grants must reconnect to consent to business_management.
# Register <public app origin>/api/v1/platforms/facebook/callback as a valid
# OAuth redirect URI. Restart `make dev` after changing these credentials.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_LIVE_ACCEPTED=false
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_ENGAGEMENT_LIVE_ACCEPTED=false
INSTAGRAM_LIVE_ACCEPTED=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_LIVE_ACCEPTED=false
# Optional override. Blank defaults to <APP_URL>/api/v1/provider-media/.
# Verify that public HTTPS domain or URL prefix in the TikTok developer portal.
TIKTOK_MEDIA_URL_PREFIX=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_ENGAGEMENT_LIVE_ACCEPTED=false
THREADS_LIVE_ACCEPTED=false
YOUTUBE_LIVE_ACCEPTED=false
YOUTUBE_SHORTS_CLIENT_ID=
YOUTUBE_SHORTS_CLIENT_SECRET=

# AI-assisted UI translations (`bun run i18n:generate --target es`). Generation
# runs offline against local Ollama when no Workers AI credentials are set, and
# never runs in CI; `bun run i18n:check` is deterministic and needs no provider.
# `auto` (default) uses Workers AI when both credentials exist, otherwise
# Ollama. Force one backend with `I18N_PROVIDER=workers-ai` or `ollama`.
# Pull the local model first: `ollama pull qwen3:8b`.
# If direnv does not load this file for you, export it before generating:
#   set -a; . ./.env; set +a
I18N_PROVIDER=auto
I18N_OLLAMA_URL=http://127.0.0.1:11434
I18N_OLLAMA_MODEL=qwen3:8b
# Create the token from the Workers AI "Use REST API" page (Workers AI Read +
# Edit, scoped to Workers AI, so it cannot deploy Workers or other resources)
# and keep it out of source and logs. The seed makes a local rerun repeatable on
# the same model; the committed locale file is the source of truth.
WORKERS_AI_ACCOUNT_ID=
WORKERS_AI_API_TOKEN=
I18N_MODEL=@cf/zai-org/glm-4.7-flash
I18N_FALLBACK_MODEL=@cf/google/gemma-4-26b-a4b-it
I18N_SEED=20261019
I18N_TIMEOUT_MS=120000

# Production self-hosting uses its own private .env.selfhost, never this
# development file. Generate it with: node scripts/selfhost/configure.mjs
# Existing BETTER_AUTH_SECRET, TOKEN_ENCRYPTION_KEY, PROCESSOR_JOB_TOKEN,
# R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY and MAIL_FROM_ADDRESS also apply there.
# OBJECT_STORAGE_PROVIDER and the S3_* settings apply there as well; the runtime
# refuses to start on a half-configured S3 deployment.
SELFHOST_ENV_FILE=.env.selfhost
SELFHOST_DATA=/data
# Forced to request in the standalone runtime, independently of auth security.
# Leave unset for the existing Cloudflare deployment's managed pool policy.
DATABASE_POOL_MODE=
SELFHOST_BIND_ADDRESS=127.0.0.1
SELFHOST_IMAGE_PREFIX=ghcr.io/meltiplyorg/meltiply
SELFHOST_IMAGE_TAG=latest
# Generated from the host architecture by scripts/selfhost/configure.mjs.
SELFHOST_PLATFORM=linux/amd64
SELFHOST_DB_PASSWORD=
SELFHOST_DB_SYSTEM_PASSWORD=
SELFHOST_DB_AUTHENTICATED_PASSWORD=
SELFHOST_OPERATOR_SECRET=
SELFHOST_SMTP_URL=
# true requires SMTP and email verification; false lets the owner sign in
# unverified. Omitted defaults to whether both mail settings above are present.
SELFHOST_REQUIRE_EMAIL_VERIFICATION=
