# Activate JSON-first PR creation through the PATH-shadow gh guard.
# See scripts/gh-guard/gh and the pr skill. Run `make hooks` without direnv.
PATH_add scripts/gh-guard

# Load the single shared local environment for Make, Wrangler, Vite, and Bun.
dotenv_if_exists .env
dotenv_if_exists .env.local
source_env_if_exists .envrc.local
