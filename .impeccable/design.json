  "narrative": {
    "northStar": "Gr8r-adapted publishing workspace",
    "overview": "Warm, compact, and flat: the interface borrows Gr8r Studio's visual language while keeping Meltiply's real publishing workflows. Quiet neutral navigation and opaque surfaces support scanning; indigo identifies actions and focus rather than decorating every panel.\n\nReact and Astro share semantic tokens. TypeScript components and Tailwind compositions extend canonical controls rather than copying page-specific primitives. Preserve the current visual state when cleaning implementation code.",
    "keyCharacteristics": [
      "Warm neutral fields with a restrained indigo accent.",
      "Geist typography, compact controls, and precise shared geometry.",
      "One visual grammar across Posts, Channels, Settings, and dialogs.",
      "Real identity, provider outcomes, and supported actions instead of reference demo features."
    ],
    "rules": [
      {
        "name": "The Shared Palette Rule",
        "body": "Use semantic roles from the shared token owner; do not create route-specific background or ink palettes.",
        "section": "colors"
      },
      {
        "name": "The One Icon Column Rule",
        "body": "Every rail row reserves the same 16px leading slot. A larger 24px identity avatar centers inside that slot instead of widening it, so icons, labels, and the account name share one axis.",
        "section": "components"
      },
      {
        "name": "The Gliding Highlight Rule",
        "body": "Rail rows never paint their own hover fill. One shared pill (SidebarGlideHighlight) springs to the hovered row and fades out on leave, in the workspace rail and the Settings section rail alike, while the row keeps its labels, focus ring, and selected surface above it.",
        "section": "components"
      },
      {
        "name": "The One Menu Surface Rule",
        "body": "Every floating list — dropdown menu, select listbox, submenu, or page-composed filter panel — renders the shared menu vocabulary, surface animation included, and a menu that hand-writes its own surface, row geometry, indicator, or motion is a defect.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** extend shared TypeScript/React controls and semantic Tailwind compositions.",
      "**Do** use one palette and consistent collection grammar across routes.",
      "**Do** keep all Settings sections within the shared content width.",
      "**Do** preserve real data, async outcomes, accessible names, and focus behavior.",
      "**Do** extend existing animation owners when adding animation."
    ],
    "donts": [
      "**Don't** restore sidebar view/profile/search subsections or obsolete view modes.",
      "**Don't** duplicate primitives, palette definitions, dialog frames, or sign-out behavior.",
      "**Don't** introduce an app motion mode, preference provider, or alternate animation branch.",
      "**Don't** copy reference-only capabilities that Meltiply does not implement.",
      "**Don't** treat compilation as visual proof; inspect actual desktop and phone states in both palettes."
    ]
  }
