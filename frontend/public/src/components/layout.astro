---
import { ClientRouter } from "astro:transitions";
import ThemeBootstrap from "@meltiply/ui/theme-bootstrap";
import favicon from "@meltiply/ui/favicon.svg?url";
interface Props {
  title: string;
  description?: string;
  markdownPath?: string;
}

const { title, description, markdownPath } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const appUrl = process.env.APP_URL?.trim() || "https://app.meltiply.com";
---

<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <ClientRouter fallback="swap" />
    <script>
      import "../scripts/public-scroll";
      import { themePreferenceAttribute } from "@meltiply/ui/theme-preference";

      document.addEventListener("astro:before-swap", (event) => {
        const currentRoot = document.documentElement;
        const nextRoot = event.newDocument.documentElement;
        const pagePreference = currentRoot.getAttribute(
          themePreferenceAttribute,
        );
        if (pagePreference === null)
          nextRoot.removeAttribute(themePreferenceAttribute);
        else nextRoot.setAttribute(themePreferenceAttribute, pagePreference);
        nextRoot.classList.toggle(
          "dark",
          currentRoot.classList.contains("dark"),
        );
        nextRoot.style.colorScheme = currentRoot.style.colorScheme;
        nextRoot.toggleAttribute(
          "data-cookie-functional",
          currentRoot.hasAttribute("data-cookie-functional"),
        );
        nextRoot.toggleAttribute(
          "data-cookie-decided",
          currentRoot.hasAttribute("data-cookie-decided"),
        );
      });
    </script>
    <ThemeBootstrap siteUrls={[appUrl]} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    {markdownPath && (
      <>
        <link
          rel="alternate"
          type="text/markdown"
          href={new URL(markdownPath, Astro.site)}
        />
        <link
          rel="describedby"
          type="text/plain"
          href={new URL("/llms.txt", Astro.site)}
        />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body class="public-canvas">
    <slot />
  </body>
</html>

<style>
  .public-canvas {
    background-image: repeating-linear-gradient(
      135deg,
      transparent 0 7px,
      color-mix(in srgb, var(--ink) 6%, transparent) 7px 8px
    );
  }
</style>
