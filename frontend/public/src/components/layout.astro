---
import { ClientRouter } from "astro:transitions";
import ConsentBootstrap from "@meltiply/ui/consent-bootstrap";
import MotionBootstrap from "@meltiply/ui/public/motion-bootstrap";
import ThemeBootstrap from "@meltiply/ui/theme-bootstrap";
import favicon from "@meltiply/ui/favicon.svg?url";
/**
 * Document shell for the landing page and public guides. Consent runs before
 * the shared class-based palette and motion bootstrap; optional stores remain
 * gated, while Astro swaps retain unsaved page intent without a flash.
 * Markdown discovery is emitted only for guides. Only app links need
 * cross-origin theme transfer; landing-to-docs navigation stays on this origin.
 */
interface Props {
  title: string;
  description?: string;
  markdownPath?: string;
}

const { title, description, markdownPath } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const appUrl = process.env.FRONTEND_URL?.trim() || "https://app.meltiply.com";
---

<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <ClientRouter fallback="swap" />
    <script>
      import "../scripts/public-scroll";
      import { themePreferenceAttribute } from "@meltiply/ui/theme-preference";

      /**
       * Carries the live preference and consent attributes into Astro's
       * incoming root. The retained theme provider and motion island do not
       * remount or reapply unchanged choices across swaps, so the new root must
       * inherit the explicit page intent, palette, consent gate, and motion flags.
       */
      document.addEventListener("astro:before-swap", (event) => {
        const currentRoot = document.documentElement;
        const nextRoot = event.newDocument.documentElement;
        const pagePreference = currentRoot.getAttribute(
          themePreferenceAttribute,
        );
        if (pagePreference === null)
          nextRoot.removeAttribute(themePreferenceAttribute);
        else nextRoot.setAttribute(themePreferenceAttribute, pagePreference);
        nextRoot.classList.toggle(
          "dark",
          currentRoot.classList.contains("dark"),
        );
        nextRoot.style.colorScheme = currentRoot.style.colorScheme;
        nextRoot.toggleAttribute(
          "data-low-motion",
          currentRoot.hasAttribute("data-low-motion"),
        );
        nextRoot.toggleAttribute(
          "data-theme-ink",
          currentRoot.hasAttribute("data-theme-ink"),
        );
        nextRoot.toggleAttribute(
          "data-cookie-functional",
          currentRoot.hasAttribute("data-cookie-functional"),
        );
        nextRoot.toggleAttribute(
          "data-cookie-decided",
          currentRoot.hasAttribute("data-cookie-decided"),
        );
      });
    </script>
    <ConsentBootstrap />
    <ThemeBootstrap mode="class" siteUrls={[appUrl]} />
    <MotionBootstrap />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    {markdownPath && (
      <>
        <link
          rel="alternate"
          type="text/markdown"
          href={new URL(markdownPath, Astro.site)}
        />
        <link
          rel="describedby"
          type="text/plain"
          href={new URL("/llms.txt", Astro.site)}
        />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <!-- THESIS: Meltiply's public surfaces share the publishing workspace's visual system.
         OWN-WORLD: Warm stone surfaces, indigo actions, Geist, compact controls.
         STORY: Understand publishing, then find setup and recovery guidance.
         FIRST VIEWPORT: Clear navigation, product content, and reachable search.
         FORM: User-pinned Gr8r Studio adaptation, 904205c626918ee96054eb35495c394a60c0c601.
         FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance -->
    <slot />
  </body>
</html>
