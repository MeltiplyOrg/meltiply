---
import {
  motionPreferenceStorageKey,
  reducedMotionQuery,
} from "@meltiply/ui/motion-state";

/**
 * Before-paint low-motion bootstrap shared by the public sites, replacing the
 * per-site inline scripts that drifted apart. Mirrors the effective preference
 * onto `html[data-low-motion]` before first paint so `motion.css` suppression
 * and any early effects code agree with the hydrated controllers that later
 * own live updates. Emits a plain inline script (no `is:inline` needed:
 * `define:vars` implies verbatim inlining), so it re-runs on Astro client
 * swaps like the theme bootstrap does.
 *
 * Render after `ConsentBootstrap`: with `manual` enabled, the stored
 * `meltiply.low-motion` choice is honored only when functional consent is
 * already resolved (`data-cookie-functional`), matching the consent-gated
 * `readStoredManualLowMotion` contract. The OS `prefers-reduced-motion` query
 * always applies. `data-theme-ink` is not consulted — it cannot persist a
 * navigation, and an in-flight reveal commits its own flag.
 *
 * @prop manual - When true (default), a consented manual low-motion choice on
 *   this origin also forces the flag. Surfaces exposing no manual control pass
 *   `manual={false}` and mirror the OS setting only.
 */
interface Props {
  manual?: boolean;
}

const { manual = true } = Astro.props;
---

<script
  define:vars={{ manual, motionPreferenceStorageKey, reducedMotionQuery }}
>
  var lowMotion = false;
  try {
    lowMotion = window.matchMedia(reducedMotionQuery).matches;
  } catch {
    /* No media query support means full motion. */
  }
  if (manual && !lowMotion) {
    var manualLowMotion = false;
    if (document.documentElement.hasAttribute("data-cookie-functional")) {
      try {
        manualLowMotion =
          window.localStorage.getItem(motionPreferenceStorageKey) === "on";
      } catch {
        /* Denied storage keeps the OS-only motion preference. */
      }
    }
    lowMotion = manualLowMotion;
  }
  document.documentElement.toggleAttribute("data-low-motion", lowMotion);
</script>
