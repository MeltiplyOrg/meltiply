{
  "name": "meltiply",
  "version": "1.0.0-target.0",
  "private": true,
  "workspaces": [
    "frontend/*",
    "packages/*",
    "workers/*"
  ],
  "type": "module",
  "scripts": {
    "setup": "./scripts/cloudflare-local/setup.sh",
    "doctor": "./scripts/cloudflare-local/doctor.sh",
    "dev:backend": "./scripts/cloudflare-local/dev-backend.sh",
    "dev:api": "./scripts/cloudflare-local/dev-api.sh",
    "local:baseline": "node scripts/cloudflare-local/measure-public-routes.mjs",
    "local:smoke": "./scripts/cloudflare-local/smoke.sh",
    "db:start": "./scripts/cloudflare-local/database.sh start",
    "db:migrate": "./scripts/cloudflare-local/database.sh migrate",
    "db:seed": "./scripts/cloudflare-local/database.sh seed",
    "reset": "./scripts/cloudflare-local/reset.sh",
    "contract:lint": "redocly lint meltiply@v1",
    "contract:bundle": "redocly bundle meltiply@v1 --output packages/contracts/dist/openapi.yaml --ext yaml",
    "contract:diff": "node packages/contracts/scripts/contract-diff.mjs",
    "contract:test-diff": "node packages/contracts/scripts/contract-diff.test.mjs",
    "contract:generate": "bun run --filter @meltiply/contracts generate",
    "contract:readiness:generate": "bun run --filter @meltiply/contracts readiness:generate",
    "contract:readiness:check": "bun run --filter @meltiply/contracts readiness:check",
    "contract:test-examples": "bun run --filter @meltiply/contracts test:examples",
    "contract:test-readiness": "bun run --filter @meltiply/contracts test:readiness",
    "contract:check": "bun run contract:lint && bun run contract:bundle && bun run contract:generate && bun run contract:test-examples && bun run contract:test-diff && bun run contract:readiness:check && bun run contract:test-readiness && bun run --filter @meltiply/contracts type-check",
    "docs:links": "node scripts/ci/docs-links.mjs",
    "test:docs-links": "node --test scripts/ci/docs-links.test.mjs",
    "docs:check": "bun run test:docs-links && bun run docs:links",
    "ci:lighthouse": "lighthouse",
    "cost:model": "node scripts/infra/cost-model.mjs",
    "cost:check": "node --test scripts/infra/cost-model.test.mjs && node scripts/infra/cost-model.mjs --check",
    "cost:require-complete": "node scripts/infra/cost-model.mjs --require-complete",
    "workers:types": "./scripts/cloudflare-local/worker-types.sh",
    "workers:type-check": "vp run --cache --filter './workers/*' --concurrency-limit 1 type-check",
    "workers:test": "vp run --filter './workers/*' --concurrency-limit 1 test",
    "workers:build": "vp run --cache --filter './workers/*' --concurrency-limit 1 build",
    "cloudflare:check": "bun run contract:check && bun run lint && bun run lint:dead && bun run format-check:cloudflare && bun run --filter frontend-app check && bun run --filter frontend-public check && vp run --cache --filter './packages/*' --filter './workers/*' --concurrency-limit 1 type-check && vp run --filter './packages/*' --filter './workers/*' --concurrency-limit 1 test && vp run --cache --filter './packages/*' --filter './workers/*' --concurrency-limit 1 build && bun run test:integration && bun run test:wrangler-drift && bun run test:frontend-directives && bun run test:local-setup && bun run test:available-port && bun run test:wrangler-env && bun run test:teardown && bun run test:dev && bun run test:quick-tunnel && bun run test:tunnel-hostname && bun run test:doctor && bun run test:k6-runner && bun run test:ci-routing && bun run test:supply-chain && bun run security:supply-chain && bun run cost:check && bun run docs:check",
    "format": "vp fmt",
    "format-check": "vp fmt --check",
    "lint": "vp lint . --type-aware --deny-warnings && node lint/astro-ui-contract.mjs",
    "lint:dead": "knip",
    "format-check:cloudflare": "vp fmt packages workers scripts/ci/*.mjs scripts/ci/*.json scripts/infra/*.mjs scripts/infra/*.json scripts/staging/*.mjs scripts/release/*.mjs package.json redocly.yaml tsconfig.base.json --check",
    "type-check": "vp run --cache -r --concurrency-limit 1 type-check",
    "test": "vp run -r --concurrency-limit 1 test",
    "test:integration": "node scripts/ci/test-integration.mjs",
    "test:local-setup": "./scripts/cloudflare-local/setup.test.sh",
    "test:dev": "./scripts/cloudflare-local/dev.test.sh",
    "test:quick-tunnel": "node --test scripts/cloudflare-local/quick-tunnel-url.test.mjs",
    "test:tunnel-hostname": "node --test scripts/cloudflare-local/tunnel-hostname.test.mjs",
    "test:available-port": "node --test scripts/cloudflare-local/available-port.test.mjs",
    "test:wrangler-env": "./scripts/cloudflare-local/wrangler-env.test.sh",
    "test:teardown": "./scripts/cloudflare-local/teardown.test.sh",
    "test:doctor": "./scripts/cloudflare-local/doctor.test.sh",
    "test:local-baseline": "node --test scripts/cloudflare-local/measure-public-routes.test.mjs",
    "iac:fmt": ".bin/tofu -chdir=infra/cloudflare fmt -recursive",
    "iac:fmt-check": ".bin/tofu -chdir=infra/cloudflare fmt -check -recursive",
    "iac:init": ".bin/tofu -chdir=infra/cloudflare init -backend=false",
    "iac:validate": ".bin/tofu -chdir=infra/cloudflare validate",
    "iac:policy": "node scripts/infra/policy-check.mjs",
    "iac:check": "./scripts/infra/check.sh",
    "queue:metrics": "node scripts/infra/queue-ops.mjs metrics",
    "queue:replay": "node scripts/infra/queue-ops.mjs replay-dlq",
    "release:approve": "node scripts/release/approve.mjs",
    "release:preflight": "node scripts/release/release.mjs preflight",
    "release:preflight:offline": "node scripts/release/release.mjs preflight --offline",
    "release:render": "node scripts/release/release.mjs render",
    "release:cron": "node scripts/release/release.mjs cron",
    "release:deploy": "node scripts/release/release.mjs deploy",
    "release:restore-point": "node scripts/release/release.mjs restore-point",
    "release:secrets": "node scripts/release/release.mjs secrets",
    "release:smoke": "node scripts/release/release.mjs smoke",
    "release:manifest": "node scripts/release/release.mjs manifest",
    "release:migrate": "node scripts/release/release.mjs migrate",
    "release:test": "node --test scripts/release/*.test.mjs",
    "staging:r2:check": "node scripts/staging/r2-acceptance.mjs",
    "staging:r2:run": "node scripts/staging/r2-acceptance.mjs --apply",
    "test:staging": "node --test scripts/staging/*.test.mjs",
    "test:ci-routing": "node --test scripts/ci/github-routing.test.mjs",
    "test:infra-policy": "node --test scripts/infra/*.test.mjs",
    "test:wrangler-drift": "node --test scripts/ci/wrangler-drift.test.mjs",
    "test:frontend-directives": "node --test scripts/ci/frontend-directives.test.mjs",
    "security:secrets": "./scripts/ci/gitleaks-check.sh",
    "security:supply-chain": "node scripts/ci/supply-chain.mjs",
    "test:supply-chain": "node --test scripts/ci/supply-chain.test.mjs",
    "hyperdrive:bootstrap": "node scripts/infra/hyperdrive-bootstrap.mjs",
    "local:k6": "./scripts/cloudflare-local/k6-run.sh",
    "local:k6:ci": "./scripts/cloudflare-local/k6-run.sh --ci",
    "test:k6-runner": "./scripts/cloudflare-local/k6-run.test.sh",
    "local:teardown": "./scripts/cloudflare-local/teardown.sh"
  },
  "dependencies": {
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@redocly/cli": "2.39.0",
    "@shadcn/lint": "^0.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "knip": "^6.32.2",
    "lighthouse": "13.4.1",
    "oxc-parser": "^0.154.0",
    "spdx-expression-parse": "5.0.0",
    "typescript": "catalog:",
    "typescript-language-server": "^5.3.0",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "overrides": {
    "@hono/node-server": "1.19.17",
    "brace-expansion@<2.0.0": "1.1.18",
    "brace-expansion@>=2.0.0 <3.0.0": "2.1.4",
    "brace-expansion@>=4.0.0 <6.0.0": "5.0.9",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.5",
    "hono": "4.13.7",
    "ip-address": "10.5.0",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.0",
    "undici": "7.29.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": "1.4.2",
    "node": ">=24.0.0 <25"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vitest": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/coverage-istanbul": "5.0.3",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@types/node": "24.10.4",
    "@types/pg": "8.20.0",
    "typescript": "^7.0.2",
    "wrangler": "4.148.0",
    "vite-plus": "1.1.0"
  },
  "patchedDependencies": {
    "@shadcn/lint@0.1.0": "patches/@shadcn%2Flint@0.1.0.patch"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver",
    "workerd"
  ]
}
