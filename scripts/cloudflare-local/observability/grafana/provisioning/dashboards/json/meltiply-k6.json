{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "dashboard",
      "keepTime": true,
      "title": "Local Traces",
      "type": "link",
      "url": "/d/meltiply-local-traces/meltiply-local-traces"
    }
  ],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(k6_http_reqs_total[1m])) or sum(rate(k6_http_reqs[1m]))",
          "legendFormat": "http req/s",
          "refId": "A"
        }
      ],
      "title": "k6 HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(k6_http_req_duration_seconds_bucket[1m])) by (le)) * 1000 or histogram_quantile(0.95, sum(rate(k6_http_req_duration_bucket[1m])) by (le))",
          "legendFormat": "p95 duration",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(k6_http_req_duration_seconds_bucket[1m])) by (le)) * 1000 or avg_over_time(k6_http_req_duration_avg[1m])",
          "legendFormat": "p50 / avg duration",
          "refId": "B"
        }
      ],
      "title": "k6 HTTP duration",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["sum"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (expected_response) (rate(k6_http_reqs_total[1m])) or sum by (status) (rate(k6_http_reqs[1m]))",
          "legendFormat": "{{expected_response}}{{status}}",
          "refId": "A"
        }
      ],
      "title": "k6 requests by status class",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(k6_http_req_failed_total[1m])) / clamp_min(sum(rate(k6_http_reqs_total[1m])), 1e-9) or sum(rate(k6_http_req_failed[1m]))",
          "legendFormat": "failed rate",
          "refId": "A"
        }
      ],
      "title": "k6 failed request rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "datasource", "uid": "grafana" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 16 },
      "id": 5,
      "options": {
        "content": "### k6 → Prometheus → Grafana\n\n```bash\n# API workers must already be up (bun run dev:backend)\nbun run local:k6\n# CI profile\nbun run local:k6:ci\n```\n\nMetrics arrive via Prometheus remote-write (`:9090`). Empty panels mean no k6 run in range.\nThreshold failures fail the k6 process (and CI).\n",
        "mode": "markdown"
      },
      "title": "How to run",
      "type": "text"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["meltiply", "local", "k6"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "title": "Meltiply k6 Load",
  "uid": "meltiply-k6-load",
  "version": 1
}
