      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": {
          "calcs": ["sum"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "sum by (context_method, context_route) (count_over_time({job=\"meltiply-worker\", service=~\"$service\"} | json | context_event=\"http_request\" | context_route=~\"$route\" [$__auto]))",
          "legendFormat": "{{context_method}} {{context_route}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "HTTP requests / interval by route",
      "type": "timeseries"
    },
