      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Live structured Worker logs. Filter with the top variables. Click a trace_id derived field to jump to Tempo.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "{job=\"meltiply-worker\", service=~\"$service\"} | json | context_route=~\"$route\" | line_format \"{{.level}} {{.service}} {{.message}} outcome={{.context_outcome}} route={{.context_route}} latency_ms={{.context_latency_ms}} request_id={{.request_id}} trace_id={{.trace_id}} {{.context_error_code}} {{.error_name}} {{.error_message}} {{.error_cause_message}}\"",
