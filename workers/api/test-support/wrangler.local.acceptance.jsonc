{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "meltiply-api-local",
  "main": "index.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  // Acceptance runs boot faster than the production local stack: the controlled
  // entry answers the fixture namespace directly and never re-enters the
  // container-backed asset pipeline from the API side.
  "limits": {
    "cpu_ms": 30000,
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  // Same bucket, same pinned local S3 credentials, and therefore the same
  // presigned upload/preview/processor URLs the browser and the container reach
  // in the production local stack. The controlled Provider stores its
  // publication records under a `controlled-provider/` key prefix in this very
  // bucket, which is how the acceptance API entry reads back what the
  // acceptance automation entry wrote.
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "meltiply-assets-local",
      "local_dev": {
        "experimental_s3_credentials": {
          "accessKeyId": "local-r2-access-key",
          "secretAccessKey": "local-r2-secret-key",
        },
      },
    },
  ],
  "hyperdrive": [
    {
      "binding": "DB_AUTHENTICATED",
      "id": "00000000000000000000000000000001",
      "localConnectionString": "postgres://meltiply_rls:meltiply-authenticated-local@127.0.0.1:5433/meltiply?sslmode=disable",
    },
    {
      "binding": "DB_SYSTEM",
      "id": "00000000000000000000000000000002",
      "localConnectionString": "postgres://meltiply_system:meltiply-system-local@127.0.0.1:5433/meltiply?sslmode=disable",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OAUTH_STATE",
        "class_name": "OAuthStateCoordinator",
        "script_name": "meltiply-state",
      },
    ],
  },
  // The eager Outbox relay dials the acceptance automation Worker over this
  // binding, which is what makes a local "publish now" write leave the database
  // immediately instead of waiting for the hourly cron.
  "services": [
    {
      "binding": "AUTOMATION",
      "service": "meltiply-automation-local",
    },
  ],
  "vars": {
    "ENVIRONMENT": "local",
    "APP_URL": "http://localhost:3000",
    "VERSION": "1.0.0-acceptance.0",
  },
}
